# ~/scripts/kernelia-worker.env en Hepha (chmod 600). Nunca en el repo.
# El wrapper lo carga con `. fichero` (sintaxis de shell, no de dotenv):
# valores entre comillas simples, sobre todo si llevan `&`, `$` o `?`.
NODE_ENV=production
# Base de datos (pooler de Supabase), la misma que usa Vercel.
DATABASE_URL=''
# Supabase Storage para las tarjetas OG (bucket publico `og-cards`).
NEXT_PUBLIC_SUPABASE_URL=''
SUPABASE_SERVICE_ROLE=''
# Opcional: un push monitor de Uptime Kuma por job (no reutilizar el de
# kernelia-cron: un job sano taparia a uno caido).
KUMA_PUSH_URL_INGEST=''
KUMA_PUSH_URL_OG_CARDS=''
